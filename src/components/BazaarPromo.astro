---
interface Props { showVolunteer?: boolean; showTime?: boolean; dark?: boolean; }
const { showVolunteer = false, showTime = true, dark = false } = Astro.props;
---

<section class:list={['bazaar-promo', { 'bazaar-promo-dark': dark, 'bazaar-promo-volunteer': showVolunteer, 'bazaar-promo-no-time': !showTime }]}>
  <div class="container bazaar-grid">
    <div>
      <span class="eyebrow">Fundraiser Save the Date</span>
      <h2>SMS PTO Soaring Eagle Bazaar</h2>
      <p class="event-meta">Date: Saturday, September 26<br />(rain date: September 27)<br />Location: Sharon Middle School{showTime && <><br />Time: 10 am to 2 pm</>}</p>
    </div>
    <div>
      <p class="lead">Join us for a community-wide celebration featuring thrift treasures, student entrepreneurs, baked goods and more—while supporting Sharon Middle School students and staff.</p>
      <p>This inaugural event brings together families, local businesses, and the community for a day of shopping, connection, and school spirit. All proceeds benefit SMS PTO programs, enrichment opportunities, and teacher appreciation initiatives.</p>
      <a class="button" href="/soaring-eagle-bazaar">Learn More</a>
      {showVolunteer && <a class="button volunteer-button" href="https://www.signupgenius.com/go/10C084DADA92EAAF4CF8-65296200-soaring#/">Sign-up to Volunteer</a>}
    </div>
  </div>
</section>

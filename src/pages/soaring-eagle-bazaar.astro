---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Soaring Eagle Bazaar | SMS PTO" description="Shop, explore, and support Sharon Middle School at the inaugural SMS PTO Soaring Eagle Bazaar.">
  <section class="bazaar-hero">
    <div class="container bazaar-hero-inner">
      <span class="eyebrow">SMS PTO presents</span>
      <h1 class="display-title">Soaring Eagle Bazaar</h1>
      <h2>Shop, Explore, and Support Sharon Middle School!</h2>
      <div class="event-banner">
        <div><span>Date</span><strong>Saturday, September 26</strong><small>Rain date: September 27</small></div>
        <div><span>Location</span><strong>Sharon Middle School</strong></div>
        <div><span>Time</span><strong>10 am to 2 pm</strong></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2 class="section-title">Event Details</h2>
        <p class="lead">Join us for the inaugural SMS PTO Fall Fair Fundraiser, a fun-filled community event bringing together local vendors, crafters, student entrepreneurs, thrift treasures, plants, baked goods, food, and more—all while supporting the Sharon Middle School PTO.</p>
        <p>Whether you're looking for unique gifts, handmade items, vintage finds, delicious treats, or simply a fun way to spend the day with family and friends, there's something for everyone.</p>
        <div class="button-row">
          <a class="button" href="#vendors">Become a Vendor</a>
          <a class="button button-outline" href="#sponsors">Become a Sponsor</a>
          <a class="button button-outline" href="https://www.signupgenius.com/go/10C084DADA92EAAF4CF8-65296200-soaring#/">Become a Volunteer</a>
        </div>
      </div>
      <div class="quote-block">
        <h2>Why Attend?</h2>
        <p>Every purchase supports educational programs, teacher appreciation initiatives, community-building events, and student activities.</p>
        <p>By shopping local and supporting small businesses, you're also helping strengthen our community.</p>
      </div>
    </div>
  </section>

  <section class="section section-cream" id="vendors">
    <div class="container content split split-wide">
      <div>
        <span class="eyebrow">For makers &amp; merchants</span>
        <h2>Interested in Becoming a Vendor?</h2>
      </div>
      <div>
        <p class="lead">We're seeking vendors, makers, crafters, plant sellers, food vendors, student entrepreneurs, and community organizations.</p>
        <div class="fees">
          <div><span>8th Grade Fee</span><strong>$0</strong></div>
          <div><span>Student Fee</span><strong>$20</strong></div>
          <div><span>Early Bird</span><strong>$35</strong><small>through August 31</small></div>
          <div><span>Regular</span><strong>$50</strong><small>September 1–25</small></div>
        </div>
        <a class="button" href="https://www.zeffy.com/en-US/ticketing/soaring-eagle-bazzar-vendors">Vendor Registration Form</a>

        <h3>Why become a vendor?</h3>
        <p>Promote your business, sell your products, meet local families, connect with the Sharon community, and support Sharon Middle School students and PTO-funded programs.</p>
        <p><strong>Student entrepreneurs are welcome.</strong> Students may apply to sell handmade items, crafts, art, baked goods, or other school-appropriate products. A parent or guardian must approve the application and be present during the event.</p>

        <h3>How will the event be set up?</h3>
        <ul>
          <li>The outdoor event will use 8 ft × 8 ft booth spaces.</li>
          <li>Ten tables are available upon request on a first-come, first-served basis.</li>
          <li>Chairs and tablecloths will not be provided.</li>
          <li>There will be no access to electricity.</li>
          <li>We recommend bringing a canopy.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="sponsors">
    <div class="container">
      <h2 class="section-title">Become a Sponsor</h2>
      <p class="lead sponsor-intro">Support the SMS PTO Fall Fair Fundraiser and connect with hundreds of local families, educators, and community members. Sponsorships fund PTO programs while giving your business valuable visibility.</p>
      <a class="button" href="https://www.zeffy.com/en-US/ticketing/soaring-eagle-bazaar-sponsorship">Sponsor Registration Form</a>
      <div class="sponsor-grid">
        <article class="card featured">
          <span>Community Sponsor</span><strong>$500–$999</strong>
          <ul><li>Medium logo on the event webpage and sponsor sign</li><li>Recognition in social media and PTO email promotions</li><li>Option to include promotional materials</li><li>Discounted vendor booth fee</li></ul>
        </article>
        <article class="card">
          <span>Friend of SMS Sponsor</span><strong>$250–$499</strong>
          <ul><li>Business name on the event webpage</li><li>Small logo on the event entrance sign</li><li>Thank-you in a PTO social post</li></ul>
        </article>
        <article class="card">
          <span>Supporter Sponsor</span><strong>$100–$249</strong>
          <ul><li>Listing on the event webpage</li><li>Recognition on event signage</li><li>Thank-you in a PTO social post</li></ul>
        </article>
      </div>
      <p class="sponsor-contact">Interested in sponsoring? Contact <a href="mailto:smspto@sharonschools.net?subject=Soaring%20Eagle%20Bazaar%20Sponsorship">smspto@sharonschools.net</a>.</p>
    </div>
  </section>

  <section class="section section-burgundy stay-connected">
    <div class="narrow">
      <h2>Stay Connected</h2>
      <p class="lead">Follow the Sharon Middle School PTO on social media and check back for event updates, vendor announcements, and volunteer opportunities.</p>
      <p>Interested in volunteering? <a href="mailto:smspto@sharonschools.net?subject=Soaring%20Eagle%20Bazaar%20Volunteer">We'd love to hear from you.</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .bazaar-hero { padding: 88px 0 70px; background: var(--gold); }
  .bazaar-hero .display-title { max-width: 830px; font-size: clamp(2.55rem,6vw,4.4rem); }
  .bazaar-hero h2 { margin: 1.4rem 0 2.5rem; font-family: 'Calistoga', Georgia, serif; font-size: clamp(1.5rem,3vw,2rem); font-weight: 400; }
  .event-banner { display: grid; grid-template-columns: 1.15fr 1fr .75fr; gap: 1px; background: rgba(89,27,27,.25); }
  .event-banner > div { display: flex; flex-direction: column; padding: 1.25rem; background: var(--burgundy); color: #fff; }
  .event-banner span { color: var(--gold-light); font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .event-banner strong { font-size: 1.08rem; }
  .event-banner small { opacity: .78; }
  .quote-block p:first-of-type { margin-top: 1.5rem; }
  .fees { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 2rem 0; background: #d2cbc0; }
  .fees > div { display: flex; flex-direction: column; padding: 1rem; background: #fff; }
  .fees strong { color: var(--burgundy); font-family: 'Calistoga', Georgia, serif; font-size: 2.2rem; }
  .sponsor-intro { max-width: 780px; }
  .sponsor-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.25rem; margin-top: 2.5rem; align-items: start; }
  .sponsor-grid article > span { display: block; color: var(--burgundy); font-family: 'Calistoga', Georgia, serif; font-size: 1.35rem; }
  .sponsor-grid article > strong { display: block; margin: .3rem 0 1rem; font-size: 1.6rem; }
  .sponsor-grid ul { padding-left: 1.15rem; }
  .sponsor-grid li { margin: .65rem 0; }
  .sponsor-grid .featured { border-top: 8px solid var(--gold); }
  .sponsor-contact { margin-top: 2rem; }
  .stay-connected { text-align: center; }
  .stay-connected h2 { margin: 0 0 1rem; color: var(--gold); font-family: 'Calistoga', Georgia, serif; font-size: 2.6rem; font-weight: 400; }
  @media (max-width: 820px) { .sponsor-grid { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .event-banner, .fees { grid-template-columns: 1fr; } }
</style>

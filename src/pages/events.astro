---
import BaseLayout from '../layouts/BaseLayout.astro';
import BazaarPromo from '../components/BazaarPromo.astro';
import NewsGrid from '../components/NewsGrid.astro';
---

<BaseLayout title="Meetings & Events | SMS PTO" description="Meetings, school events, and community activities from the Sharon Middle School PTO." current="events">
  <section class="page-hero">
    <div class="container">
      <h1 class="display-title">What's Happening</h1>
      <p>The SMS PTO brings our school community together through events that celebrate and support the SMS families, students, and teachers.</p>
    </div>
  </section>

  <BazaarPromo dark={true} />

  <section class="events-news">
    <div class="container">
      <NewsGrid limit={4} compact={true} />
      <div class="center"><a class="button button-outline" href="/news">View all news</a></div>
    </div>
  </section>

  <section class="meetings-section">
    <div class="container meetings-grid">
      <div>
        <h2 class="meeting-title">PTO Meetings</h2>
        <p class="meeting-lead">Parents, guardians, and staff are welcome! Join us to stay informed, share ideas, and get involved in the programs that make SMS such a great place to learn and grow.</p>
      </div>
      <div>
        <p>Meetings are typically held at the Sharon Middle School Library at 7:00 pm unless otherwise noted.</p>
        <ul class="meeting-list">
          <li><span>September 9:</span><a href="https://c7b909f4-d13c-466d-a683-b19c81a7d16e.filesusr.com/ugd/88c316_ab57899bec8b4f34839596c8196664ae.pdf">Meeting Minutes</a></li>
          <li><span>October 14:</span><a href="https://smspto.wixsite.com/smspto/post/october-14-meeting">Meeting Minutes</a></li>
          <li><span>November 18:</span><span>Guest Speaker Dr. Joel Jocelyn, Assistant Superintendent for Curriculum and Instruction</span></li>
          <li><span>February 24:</span><span>Special guest SMS Student Council</span></li>
          <li><span>March 17:</span><span>Double date with Work Language Coordinator and Dean of Student Affairs</span></li>
          <li><span>May 5:</span><span>Members of the Sharon School Committee will join for a focused dialogue about SMS</span></li>
          <li><span>June 2:</span><span>Welcome 5th Grade Parents to SMS. Please help us create a warm welcome for rising 6th grade families</span></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .events-news { height: 503px; padding: 40px 0 30px; background: var(--cream); }
  .center { margin-top: 2.25rem; text-align: center; }
  .meetings-section { height: 377px; padding: 39px 0 28px; color: #000; background: #fff; }
  .meetings-grid { display: grid; grid-template-columns: 342px 1fr; gap: 38px; }
  .meeting-title { margin: 0 0 18px; color: var(--burgundy); font-family: 'Calistoga', Georgia, serif; font-size: 36px; line-height: 1.1; font-weight: 400; }
  .meeting-lead { max-width: 330px; font-weight: 700; }
  .meeting-list { margin: 1.35rem 0 0; padding-left: 1.2rem; }
  .meeting-list li { margin: 2px 0; }
  .meeting-list li > * { display: inline; }
  .meeting-list li > span:first-child { margin-right: .3rem; }
  @media (max-width: 820px) {
    .events-news, .meetings-section { height: auto; padding: 54px 0; }
    .meetings-grid { grid-template-columns: 1fr; }
  }
</style>

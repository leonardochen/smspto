---
import BaseLayout from '../layouts/BaseLayout.astro';
import BazaarPromo from '../components/BazaarPromo.astro';
import FundingTable from '../components/FundingTable.astro';
---

<BaseLayout title="SMS PTO | About Us" description="Sharon Middle School PTO brings together families, educators, and community members to support our school." current="home">
  <section class="home-hero">
    <div class="container hero-stage">
      <img class="hero-photo" src="/images/sms-school.avif" alt="Sharon Middle School" />
      <div class="hero-card">
        <h1 class="display-title">Sharon<br />Middle<br />School PTO</h1>
        <h2>Building community. Supporting educators. Enriching student life.</h2>
        <p>The SMS PTO brings together families, educators, and community members to support our school and strengthen connections. Together, we help fund enrichment opportunities, celebrate our dedicated staff, and create meaningful experiences for students.</p>
        <a class="button" href="/support-us">Support Us</a>
      </div>
    </div>
  </section>

  <BazaarPromo />

  <section class="why-section">
    <div class="container why-grid">
      <h2 class="section-title">Why SMS PTO Matters</h2>
      <div>
        <h3 class="goal-title">Help Us Reach Our $45K Goal</h3>
        <p>The Sharon Middle School PTO brings together more than 750 families from all three Sharon elementary schools, creating one united middle school community.</p>
        <p>We support teachers and staff with resources, enrichment opportunities, and programs that directly enhance the student experience during one of the most exciting and transformative stages of childhood.</p>
        <h3 class="goal-title funding-heading">What We Fund</h3>
        <FundingTable />
        <p><small>* Two enrichment programs per grade per year.</small></p>
        <p>Every dollar donated to the SMS PTO supports programs, resources, and experiences that directly benefit students, teachers, and families.</p>
        <a class="button" href="/support-us">Learn About Our Programs</a>
      </div>
    </div>
  </section>

  <section class="home-news">
    <div class="container">
      <h2 class="section-title">What's Happening</h2>
      <div class="home-news-grid">
        <a class="feature-post" href="/post/donate-your-gently-used-items">
          <img src="/images/donate-items.avif" alt="Donate your gently used items" />
          <div><time>Jun 22</time><h3>DONATE YOUR GENTLY USED ITEMS!</h3><p>Clean out your closets. Support SMS students. Make a difference!</p></div>
        </a>
        <div class="mini-posts">
          <a href="/post/special-discounts-during-teacher-appreciation-week"><img src="/images/teacher-discounts.avif" alt="Teacher discounts" /><div><h3>Special discounts during Teacher Appreciation Week</h3><time>May 5</time></div></a>
          <a href="/post/teacher-appreciation-week-may-4-8"><img src="/images/teacher-week.avif" alt="Teacher Appreciation Week" /><div><h3>Teacher Appreciation Week: May 4–8</h3><time>Apr 16</time></div></a>
          <a href="/post/bulletin-april-10"><img src="/images/bulletin-april-10.avif" alt="Bulletin April 10" /><div><h3>Bulletin: April 10</h3><time>Apr 9</time></div></a>
        </div>
        <div class="calendar-preview">
          <div class="calendar-day"><strong>26</strong><span>AUG, WED</span></div>
          <p>Showing events until Aug 25, 2027.</p>
          <a href="https://drive.google.com/file/d/1bO_slkvNcLussbZuy4UcYtBmVcZH599Y/view">Look for more</a>
          <small>smspto@sharonschools.net</small>
        </div>
      </div>
      <a class="all-news" href="/news">View all news</a>
    </div>
  </section>

  <section class="meet-section">
    <div class="container">
      <h2 class="section-title">Meet Your PTO</h2>
      <div class="meet-grid">
        <div class="people">
          <h3>PTO Board</h3>
          <dl>
            <div><dt>President</dt><dd>Lindsay Boyle</dd></div>
            <div><dt>Secretary</dt><dd>Kathleen Nasti</dd></div>
            <div><dt>Treasurer</dt><dd>David Straus</dd></div>
          </dl>
          <h3>Committee Chairs</h3>
          <dl>
            <div><dt>Book Sale</dt><dd>Elizabeth Kassab</dd></div>
            <div><dt>Enrichment Programs</dt><dd>Evgenia Vasilets</dd></div>
            <div><dt>Family Events</dt><dd>Preeti Abilash</dd></div>
            <div><dt>Fundraising</dt><dd>Open</dd></div>
            <div><dt>Hospitality</dt><dd>Kim Dinan</dd></div>
            <div><dt>Membership</dt><dd>Debbie Gajewski</dd></div>
            <div><dt>Scholarships</dt><dd>Kim Hokanson</dd></div>
            <div><dt>Spirit Wear Store</dt><dd>Michelle Kesselman</dd></div>
            <div><dt>Marketing &amp; Communications</dt><dd>Brigitte Chen</dd></div>
            <div><dt>Teacher Appreciation Week</dt><dd>Amanda Dorris &amp; Evgenia Vasilets</dd></div>
            <div><dt>Technology</dt><dd>Leo Chen</dd></div>
            <div><dt>8th Grade Fundraising</dt><dd>Nicole Pinkos</dd></div>
          </dl>
        </div>
        <div class="meetings">
          <h3>Meetings</h3>
          <p>All SMS parents and guardians and teachers are welcome to attend the PTO’s monthly meetings.</p>
          <p>Meetings are typically held at the Sharon Middle School Library at 7:00 pm unless otherwise noted.</p>
          <ul>
            <li><strong>September 9:</strong> <a href="https://c7b909f4-d13c-466d-a683-b19c81a7d16e.filesusr.com/ugd/88c316_ab57899bec8b4f34839596c8196664ae.pdf">Meeting Minutes</a></li>
            <li><strong>October 14:</strong> <a href="https://smspto.wixsite.com/smspto/post/october-14-meeting">Meeting Minutes</a></li>
            <li><strong>November 18:</strong> Guest Speaker Dr. Joel Jocelyn</li>
            <li><strong>February 24:</strong> Special guest SMS Student Council</li>
            <li><strong>March 17:</strong> World Language Coordinator and Dean of Student Affairs</li>
            <li><strong>May 5:</strong> Members of the Sharon School Committee</li>
            <li><strong>June 2:</strong> Welcome 5th Grade Parents to SMS</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { height: 679px; padding: 59px 0 0; background: var(--burgundy); }
  .hero-stage { position: relative; width: min(1105px, calc(100% - 40px)); min-height: 567px; }
  .hero-photo { width: 65%; height: 462px; object-fit: cover; }
  .hero-card { position: absolute; top: 43px; right: 0; width: 607px; height: 525px; padding: 44px 78px 38px 85px; background: #fff; }
  .hero-card h2 { margin: 1.65rem 0 1.3rem; font-family: 'Calistoga', Georgia, serif; font-size: 1.35rem; line-height: 1.4; font-weight: 400; }
  .hero-card p { margin-bottom: 1.6rem; }
  .why-section { height: 819px; padding: 40px 0; color: #fff; background: var(--burgundy); }
  .why-grid { display: grid; grid-template-columns: 257px 1fr; gap: 81px; }
  .why-section .section-title { color: #fff; }
  .goal-title { margin: 0 0 1.25rem; font-family: 'Lulo Clean', sans-serif; font-size: 1.25rem; line-height: 1.3; text-transform: uppercase; }
  .funding-heading { margin-top: 1.7rem; }
  .home-news { height: 581px; padding: 40px 0 32px; background: #e8e6e6; }
  .home-news-grid { display: grid; grid-template-columns: 293px 1fr 293px; gap: 24px; height: 410px; }
  .feature-post { color: inherit; background: #fff; text-decoration: none; }
  .feature-post img { width: 100%; height: 165px; object-fit: cover; }
  .feature-post div { padding: 20px 24px; }
  .feature-post h3, .mini-posts h3 { margin: .7rem 0; font-family: 'Calistoga', Georgia, serif; font-size: 1.05rem; line-height: 1.25; }
  .feature-post time, .mini-posts time { font-size: .78rem; }
  .mini-posts { display: grid; grid-template-rows: repeat(3, 1fr); gap: 12px; }
  .mini-posts a { display: grid; grid-template-columns: 114px 1fr; gap: 14px; color: inherit; background: #fff; text-decoration: none; }
  .mini-posts img { width: 114px; height: 100%; object-fit: cover; }
  .mini-posts div { padding: 10px 10px 8px 0; }
  .mini-posts h3 { margin: 0 0 .5rem; font-size: .92rem; }
  .calendar-preview { position: relative; padding: 24px; background: #fff; }
  .calendar-day { display: flex; align-items: center; gap: 12px; padding-bottom: 14px; border-bottom: 2px solid #c2a9b8; }
  .calendar-day strong { width: 38px; height: 38px; display: grid; place-items: center; color: #fff; background: #4f6ccc; border-radius: 50%; }
  .calendar-day span { color: #5570bc; font-size: .78rem; font-weight: 700; }
  .calendar-preview > a { position: absolute; top: 93px; right: 24px; color: #3265bd; text-decoration: none; }
  .calendar-preview small { position: absolute; right: 18px; bottom: 14px; left: 18px; padding-top: 8px; border-top: 1px solid #ddd; }
  .all-news { display: inline-block; margin-top: 13px; color: var(--burgundy); font-size: .9rem; }
  .meet-section { height: 639px; padding: 32px 0; }
  .meet-grid { display: grid; grid-template-columns: 420px 1fr; gap: 85px; }
  .people h3, .meetings h3 { margin: 0 0 1rem; font-family: 'Lulo Clean', sans-serif; font-size: 1.15rem; letter-spacing: .08em; text-transform: uppercase; }
  dl { margin: 0; }
  dl div { display: block; padding: 0; border: 0; font-size: .87rem; }
  dt { font-weight: 700; }
  dd { display: inline; margin: 0; }
  dt { display: inline; }
  dt::after { content: ': '; }
  .people dl { margin-bottom: 1.2rem; }
  .meetings { padding-top: 9px; font-size: .94rem; }
  .meetings li { margin: .34rem 0; }
  @media (max-width: 820px) {
    .home-hero { height: auto; min-height: auto; padding-bottom: 42px; }
    .hero-stage { min-height: auto; }
    .hero-photo { width: 100%; height: 360px; }
    .hero-card { position: relative; top: auto; right: auto; width: calc(100% - 28px); min-height: 0; margin: -80px 0 0 auto; padding: 36px; }
    .why-section, .home-news, .meet-section { height: auto; }
    .why-grid, .home-news-grid, .meet-grid { grid-template-columns: 1fr; }
    .home-news-grid { height: auto; }
    .calendar-preview { min-height: 300px; }
  }
  @media (max-width: 560px) {
    .hero-photo { height: 270px; }
    .hero-card { width: calc(100% - 14px); margin-top: -44px; padding: 28px 22px; }
    .mini-posts a { grid-template-columns: 100px 1fr; }
  }
</style>

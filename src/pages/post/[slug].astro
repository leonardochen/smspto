---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';

export function getStaticPaths() {
  return Object.entries(posts).map(([slug, post]) => ({ params: { slug }, props: { post } }));
}

const { post } = Astro.props;
---

<BaseLayout title={`${post.title} | SMS PTO`} description={post.intro} current="news">
  <article>
    <header class="post-header">
      <div class="narrow">
        <a class="back-link" href="/news">← All news</a>
        <h1>{post.title}</h1>
        <time>{post.date}</time>
      </div>
    </header>
    <div class="narrow post-body">
      <img src={post.image} alt={post.title} />
      <p class="lead">{post.intro}</p>
      {post.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <div class="share-line">
        <span>Stay connected</span>
        <a href="https://www.facebook.com/ptosms">Facebook</a>
        <a href="https://www.instagram.com/smspto2026/">Instagram</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-header { padding: 72px 0; background: var(--burgundy); color: #fff; }
  .back-link { display: inline-block; margin-bottom: 1.5rem; color: var(--gold); font-weight: 700; text-decoration: none; }
  .post-header h1 { margin: 0 0 1.2rem; font-family: 'Calistoga', Georgia, serif; font-size: clamp(2.4rem,6vw,4rem); line-height: 1.05; font-weight: 400; }
  .post-body { padding-top: 64px; padding-bottom: 80px; }
  .post-body > img { width: 100%; max-height: 650px; margin-bottom: 2.5rem; object-fit: cover; }
  .post-body p { max-width: 680px; }
  .share-line { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
  .share-line span { margin-right: auto; font-weight: 700; }
</style>
